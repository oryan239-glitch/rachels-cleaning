---
import { site } from "../data/site";
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="bar">
      <div class="copy">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-heading">Get a quote</h2>
        <p class="meta">
          <a href={site.phoneHref}>{site.phone}</a>
          <span aria-hidden="true">·</span>
          <a href={site.emailHref}>{site.email}</a>
          <span aria-hidden="true">·</span>
          <span>{site.address.city}, {site.address.region}</span>
        </p>
      </div>

      <form
        class="quote-form"
        id="quote-form"
        action={`mailto:${site.email}`}
        method="get"
        enctype="text/plain"
      >
        <input type="text" name="name" placeholder="Name" required aria-label="Name" />
        <input type="tel" name="phone" placeholder="Phone" required aria-label="Phone" />
        <input type="email" name="email" placeholder="Email" required aria-label="Email" />
        <input type="text" name="body" placeholder="What do you need cleaned?" required aria-label="Message" />
        <button class="btn btn-primary" type="submit">{site.cta.primary}</button>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 2rem 0 2.5rem;
    background: var(--pink-blush, #fdf2f7);
    border-top: 1px solid var(--line, #ebe6ea);
  }

  .bar {
    display: grid;
    gap: 1rem;
    align-items: end;
  }

  .eyebrow {
    margin: 0 0 0.25rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--pink-deep);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.45rem, 3vw, 1.85rem);
    line-height: 1.15;
  }

  .meta {
    margin: 0.4rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.55rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .meta a {
    color: var(--pink-deep);
    font-weight: 700;
  }

  .quote-form {
    display: grid;
    gap: 0.5rem;
    background: #fff;
    border: 1px solid var(--line, #ebe6ea);
    border-radius: 14px;
    padding: 0.75rem;
    box-shadow: var(--shadow);
  }

  .quote-form input {
    width: 100%;
    border: 1px solid #d8d2d6;
    border-radius: 10px;
    padding: 0.55rem 0.75rem;
    background: #fafafa;
    font: inherit;
  }

  .quote-form input:focus {
    outline: 3px solid color-mix(in srgb, var(--pink) 35%, white);
    border-color: var(--pink-hot);
    background: #fff;
  }

  .quote-form .btn {
    width: 100%;
    padding: 0.65rem 1rem;
  }

  @media (min-width: 900px) {
    .bar {
      grid-template-columns: minmax(12rem, 0.9fr) minmax(0, 1.4fr);
      gap: 1.5rem;
      align-items: center;
    }

    .quote-form {
      grid-template-columns: 1fr 1fr 1fr auto;
      grid-template-rows: auto auto;
      align-items: center;
    }

    .quote-form input:nth-child(3),
    .quote-form input:nth-child(4) {
      grid-column: span 1;
    }

    .quote-form input:nth-child(4) {
      grid-column: 1 / 4;
    }

    .quote-form .btn {
      grid-column: 4;
      grid-row: 1 / 3;
      width: auto;
      min-width: 9.5rem;
      height: 100%;
      align-self: stretch;
    }
  }
</style>
