---
import QuoteForm from "./QuoteForm.astro";
import { site } from "../data/site";
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="panel" id="quote">
      <header class="head">
        <div class="copy">
          <h2 id="contact-heading">Request a Quote</h2>
          <p class="lead">
            A few property details for a clear estimate—no obligation.
          </p>
        </div>
        <p class="meta">
          <a href={site.phoneHref}>{site.phone}</a>
          <span aria-hidden="true">·</span>
          <a href={site.emailHref}>{site.email}</a>
        </p>
      </header>
      <QuoteForm />
    </div>
  </div>
</section>

<script>
  function focusQuote() {
    const el = document.getElementById("contact");
    if (!el) return;
    if (location.hash === "#contact" || location.hash === "#quote") {
      el.scrollIntoView({ behavior: "smooth", block: "start" });
      const first = el.querySelector<HTMLInputElement>("input, textarea, select");
      first?.focus({ preventScroll: true });
    }
  }
  focusQuote();
  window.addEventListener("hashchange", focusQuote);
</script>

<style>
  .contact {
    padding: 0.75rem 0 1rem;
    background: var(--bg);
    border-top: 1px solid var(--line, #ebe6ea);
    scroll-margin-top: 8rem;
  }

  .panel {
    background: #fff;
    border: 1px solid var(--line, #ebe6ea);
    border-radius: 12px;
    padding: 0.55rem 0.75rem 0.65rem;
    box-shadow: var(--shadow);
    max-width: 42rem;
    scroll-margin-top: 8rem;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 0.85rem;
    margin-bottom: 0.5rem;
  }

  h2 {
    margin: 0 0 0.15rem;
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.15rem, 2.4vw, 1.35rem);
    line-height: 1.2;
  }

  .lead {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    line-height: 1.35;
    max-width: none;
  }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.35rem;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .meta a {
    color: var(--pink-deep);
    font-weight: 700;
  }

  @media (min-width: 800px) {
    .panel {
      padding: 0.65rem 0.9rem 0.7rem;
      max-width: 48rem;
    }
  }
</style>
