---
import { site } from "../data/site";
---

<div class="call-bar" role="region" aria-label="Call us">
  <a class="call-bar-link" href={site.phoneHref}>
    <span class="call-bar-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path
          d="M6.6 10.8c1.5 3 3.6 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.2 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z"
          fill="currentColor"
        />
      </svg>
    </span>
    <span class="call-bar-text">
      <span class="call-bar-label">{site.cta.call}</span>
      <span class="call-bar-number">{site.phone}</span>
    </span>
  </a>
</div>

<style>
  .call-bar {
    position: sticky;
    top: 0;
    z-index: 60;
    background: linear-gradient(90deg, var(--pink-deep) 0%, var(--pink-hot) 100%);
    box-shadow: 0 2px 12px rgba(194, 24, 91, 0.28);
  }

  .call-bar-link {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 52px;
    padding: 0.65rem 1rem;
    color: white;
    font-weight: 700;
    text-align: center;
    -webkit-tap-highlight-color: transparent;
  }

  .call-bar-link:hover,
  .call-bar-link:focus-visible {
    background: rgba(0, 0, 0, 0.08);
  }

  .call-bar-icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    flex-shrink: 0;
  }

  .call-bar-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
    gap: 0.15rem;
  }

  .call-bar-label {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.92;
  }

  .call-bar-number {
    font-size: 1.2rem;
    letter-spacing: 0.02em;
  }

  @media (min-width: 640px) {
    .call-bar-text {
      flex-direction: row;
      align-items: center;
      gap: 0.65rem;
    }

    .call-bar-label {
      font-size: 0.85rem;
    }

    .call-bar-number {
      font-size: 1.15rem;
    }

    .call-bar-label::after {
      content: "·";
      margin-left: 0.65rem;
      opacity: 0.7;
    }
  }
</style>
