---
import { site, stats, gallery } from "../data/site";
---

<section class="section feature" aria-labelledby="feature-heading">
  <div class="container feature-grid">
    <div class="copy">
      <p class="eyebrow">The Rachel Difference</p>
      <h2 id="feature-heading" class="section-title">
        Spotless Spaces. <span class="accent">Real Results.</span>
      </h2>
      <p class="lead">
        Every visit is tailored to your home—kitchens, baths, floors, and guest-ready
        bedrooms finished with care. See the kind of spaces we love to leave behind.
      </p>
      <div class="stats">
        {
          stats.map((s) => (
            <div class="stat">
              <strong>{s.value}</strong>
              <span>{s.label}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="visual">
      <div class="main-shot">
        <img
          src={site.images.feature}
          alt="Open living and dining room after cleaning"
          width="900"
          height="700"
          loading="lazy"
        />
      </div>
      <div class="side-shot">
        <img
          src={site.images.featureAlt}
          alt="Modern living room interior"
          width="500"
          height="620"
          loading="lazy"
        />
      </div>
    </div>
  </div>

  <div class="container gallery">
    {
      gallery.map((item) => (
        <figure>
          <img src={item.src} alt={item.alt} width="480" height="360" loading="lazy" />
        </figure>
      ))
    }
  </div>
</section>

<style>
  .feature {
    background:
      linear-gradient(180deg, var(--bg) 0%, var(--bg-soft) 100%);
  }

  .feature-grid {
    display: grid;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 1.75rem 0 0;
  }

  .stat {
    background: white;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 1rem 1.05rem;
    box-shadow: var(--shadow);
  }

  .stat strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.55rem;
    color: var(--pink-deep);
    line-height: 1.1;
    margin-bottom: 0.2rem;
  }

  .stat span {
    color: var(--muted);
    font-size: 0.86rem;
    font-weight: 600;
  }

  .visual {
    display: grid;
    gap: 0.85rem;
  }

  .main-shot,
  .side-shot {
    border-radius: 22px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .main-shot img,
  .side-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .main-shot {
    min-height: 260px;
    aspect-ratio: 5 / 4;
  }

  .side-shot {
    min-height: 200px;
    aspect-ratio: 16 / 10;
  }

  .gallery {
    display: grid;
    gap: 0.85rem;
    grid-template-columns: repeat(2, 1fr);
  }

  .gallery figure {
    margin: 0;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: var(--shadow);
    aspect-ratio: 4 / 3;
  }

  .gallery img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .gallery figure:hover img {
    transform: scale(1.04);
  }

  @media (min-width: 900px) {
    .feature-grid {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 3.5rem;
      align-items: center;
    }

    .visual {
      grid-template-columns: 1.25fr 0.85fr;
      align-items: stretch;
    }

    .main-shot,
    .side-shot {
      min-height: 420px;
      height: 100%;
      aspect-ratio: auto;
    }

    .gallery {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
