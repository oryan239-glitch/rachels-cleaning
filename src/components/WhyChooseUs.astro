---
import { site, aboutHighlights } from "../data/site";
---

<section class="section why" id="about" aria-labelledby="why-heading">
  <div class="container why-grid">
    <div class="why-visual">
      <img
        src="/images/hero-kitchen.jpg"
        alt="Bright, freshly cleaned home interior"
        width="800"
        height="720"
        loading="lazy"
      />
    </div>
    <div class="why-copy">
      <p class="eyebrow">About Us</p>
      <h2 id="why-heading" class="section-title">
        Why Homeowners <span class="accent">Choose Us</span>
      </h2>
      <p class="lead">
        Enjoy more time, less worry, and a beautifully maintained home with
        {site.name}.
      </p>
      <ul class="highlights">
        {
          aboutHighlights.map((item) => (
            <li>
              <span class="chev" aria-hidden="true">»</span>
              {item}
            </li>
          ))
        }
      </ul>
      <div class="owner">
        <img
          src="/images/rachel-avatar.jpg"
          alt={site.owner}
          width="64"
          height="64"
          loading="lazy"
        />
        <div>
          <strong>{site.owner}</strong>
          <a href={site.phoneHref}>{site.phone}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .why-grid {
    display: grid;
    gap: 2rem;
  }

  .why-visual {
    border-radius: 20px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .why-visual img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    min-height: 280px;
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: grid;
    gap: 0.75rem;
  }

  .highlights li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    font-weight: 600;
  }

  .chev {
    color: var(--pink-hot);
    font-weight: 700;
  }

  .owner {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .owner img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--pink-soft);
  }

  .owner strong {
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.95rem;
  }

  .owner a {
    color: var(--muted);
    font-weight: 500;
  }

  .owner a:hover {
    color: var(--pink-hot);
  }

  @media (min-width: 900px) {
    .why-grid {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 3.5rem;
      align-items: center;
    }
  }
</style>
