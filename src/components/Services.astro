---
import { site, services } from "../data/site";

const icons = [
  "/images/service-icon-1.png",
  "/images/service-icon-2.png",
  "/images/service-icon-3.png",
  "/images/service-icon-1.png",
  "/images/service-icon-2.png",
  "/images/service-icon-3.png",
  "/images/service-icon-1.png",
  "/images/service-icon-2.png",
];
---

<section class="section section-blush" id="services" aria-labelledby="services-heading">
  <div class="container">
    <div class="intro">
      <p class="eyebrow">What We Offer</p>
      <h2 id="services-heading" class="section-title">
        Cleaning <span class="accent">Services</span>
      </h2>
      <p class="lead">
        From everyday refresh cleans to specialized turnovers, we keep Southwest
        Florida homes guest-ready and genuinely clean.
      </p>
    </div>

    <div class="grid">
      {
        services.map((service, i) => (
          <article class:list={["card", service.accent === "pink" ? "card-pink" : "card-white"]}>
            <img
              class="icon"
              src={icons[i % icons.length]}
              alt=""
              width="96"
              height="96"
              loading="lazy"
            />
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <a
              class:list={["btn", service.accent === "pink" ? "btn-white" : "btn-primary"]}
              href="/#contact"
            >
              {site.cta.secondary}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intro {
    margin-bottom: 2.25rem;
    max-width: 40rem;
  }

  .grid {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
  }

  .card {
    border-radius: 18px;
    padding: 1.75rem 1.4rem 1.6rem;
    box-shadow: var(--shadow);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100%;
  }

  .card-pink {
    background: var(--pink-hot);
    color: white;
  }

  .card-white {
    background: white;
    color: var(--ink);
  }

  .icon {
    width: 86px;
    height: 86px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 1rem;
    border: 3px solid rgba(255, 255, 255, 0.55);
    background: white;
  }

  .card-white .icon {
    border-color: var(--pink-soft);
  }

  h3 {
    font-size: 1.2rem;
    margin-bottom: 0.55rem;
  }

  p {
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
    flex: 1;
    opacity: 0.95;
  }

  .card-white p {
    color: var(--muted);
  }

  .btn {
    width: 100%;
    max-width: 12rem;
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 980px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
