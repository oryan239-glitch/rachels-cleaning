---
import { residentialServices, commercialServices } from "../data/site";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="section section-blush" id="services" aria-labelledby="services-heading">
  <div class="container">
    <div class="intro">
      <p class="eyebrow">What We Offer</p>
      <h2 id="services-heading" class="section-title">
        Cleaning <span class="accent">Services</span>
      </h2>
      <p class="lead">
        From everyday refresh cleans to specialized turnovers, we keep Southwest
        Florida homes guest-ready and genuinely clean.
      </p>
    </div>

    <div class="grid">
      {
        residentialServices.map((service) => (
          <a
            class:list={["card", service.accent === "pink" ? "card-pink" : "card-white"]}
            href={`${base}services/${service.id}`}
          >
            <div class="photo">
              <img
                src={service.image}
                alt=""
                width="400"
                height="400"
                loading="lazy"
              />
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <span class="more">Learn more</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<section class="section section-blush commercial" id="commercial" aria-labelledby="commercial-heading">
  <div class="container">
    <div class="intro">
      <p class="eyebrow">For Businesses</p>
      <h2 id="commercial-heading" class="section-title">
        Commercial <span class="accent">Services</span>
      </h2>
      <p class="lead">
        Professional cleaning for offices and businesses across Southwest
        Florida—keeping workspaces fresh, tidy, and welcoming.
      </p>
    </div>

    <div class="grid">
      {
        commercialServices.map((service) => (
          <a
            class:list={["card", service.accent === "pink" ? "card-pink" : "card-white"]}
            href={`${base}services/${service.id}`}
          >
            <div class="photo">
              <img
                src={service.image}
                alt=""
                width="400"
                height="400"
                loading="lazy"
              />
            </div>
            <h3>{service.title}</h3>
            <p>{service.description}</p>
            <span class="more">Learn more</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intro {
    margin-bottom: 2.5rem;
    max-width: 40rem;
  }

  .commercial {
    padding-top: 0.5rem;
  }

  .grid {
    display: grid;
    gap: 1.15rem;
    grid-template-columns: 1fr;
  }

  .card {
    border-radius: 22px;
    padding: 1.5rem 1.35rem 1.55rem;
    box-shadow: var(--shadow);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-height: 100%;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    color: inherit;
  }

  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .card-pink {
    background: linear-gradient(160deg, var(--pink-hot), var(--pink-deep));
    color: white;
  }

  .card-white {
    background: white;
    color: var(--ink);
    border: 1px solid var(--line);
  }

  .photo {
    width: 92px;
    height: 92px;
    border-radius: 50%;
    overflow: hidden;
    margin-bottom: 1.05rem;
    border: 3px solid rgba(255, 255, 255, 0.65);
    box-shadow: 0 8px 18px rgba(26, 21, 35, 0.12);
  }

  .card-white .photo {
    border-color: var(--pink-soft);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h3 {
    font-size: 1.22rem;
    margin-bottom: 0.55rem;
    font-family: var(--font-display);
  }

  p {
    font-size: 0.94rem;
    margin-bottom: 0.85rem;
    flex: 1;
    opacity: 0.95;
    line-height: 1.55;
  }

  .card-white p {
    color: var(--muted);
  }

  .more {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    opacity: 0.92;
  }

  .card-white .more {
    color: var(--pink-deep);
  }

  @media (min-width: 640px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 980px) {
    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
