---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteForm from "../components/QuoteForm.astro";
import { site } from "../data/site";

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout
  title={`Request a Quote | ${site.name}`}
  description={`Request a free cleaning quote from ${site.name}. Tell us about your home—sq ft, bedrooms, bathrooms, and pets—and we’ll follow up quickly.`}
  path="/quote"
>
  <section class="quote-page" aria-labelledby="quote-heading">
    <div class="container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href={base}>Home</a>
        <span aria-hidden="true">/</span>
        <span>Request a Quote</span>
      </nav>

      <div class="panel">
        <header class="head">
          <h1 id="quote-heading">Request a Quote</h1>
          <p class="meta">
            <a href={site.phoneHref}>{site.phone}</a>
            <span aria-hidden="true">·</span>
            <a href={site.emailHref}>{site.email}</a>
          </p>
        </header>
        <p class="lead">A few property details for a clear estimate.</p>
        <QuoteForm />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .quote-page {
    padding: 0.65rem 0 1.15rem;
    background: var(--bg);
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    align-items: center;
    font-size: 0.78rem;
    color: var(--muted);
    margin-bottom: 0.55rem;
  }

  .crumb a {
    color: var(--pink-deep);
    font-weight: 600;
  }

  .crumb a:hover {
    color: var(--pink-hot);
  }

  .panel {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.75rem 0.9rem 0.85rem;
    box-shadow: var(--shadow);
    max-width: 40rem;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 0.85rem;
    margin-bottom: 0.25rem;
  }

  h1 {
    margin: 0;
    font-size: 1.2rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .lead {
    margin: 0 0 0.55rem;
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--muted);
    max-width: none;
  }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.35rem;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .meta a {
    color: var(--pink-deep);
    font-weight: 700;
  }
</style>
