---
import { site } from "../data/site";
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <span class="brand-mark" aria-hidden="true">R</span>
      <span class="brand-text">
        <span class="brand-script">Rachel's</span>
        <span class="brand-sub">Cleaning Services</span>
      </span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {
        site.nav.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="btn btn-outline phone-btn" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn-primary quote-btn" href="/#contact">{site.cta.primary}</a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        id="menu-toggle"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="nav-mobile" id="mobile-nav" aria-label="Mobile" hidden>
    {
      site.nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))
    }
    <a class="btn btn-outline" href={site.phoneHref}>{site.phone}</a>
    <a class="btn btn-primary" href="/#contact">{site.cta.primary}</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    if (panel) panel.hidden = open;
  });
  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      if (toggle && panel) {
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Open menu");
        panel.hidden = true;
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 4px 18px rgba(15, 23, 42, 0.04);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 76px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
  }

  .brand-mark {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(145deg, var(--pink-hot), var(--pink-deep));
    color: white;
    display: grid;
    place-items: center;
    font-family: Georgia, serif;
    font-style: italic;
    font-size: 1.35rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-script {
    color: var(--pink-hot);
    font-family: Georgia, "Times New Roman", serif;
    font-style: italic;
    font-size: 1.35rem;
    font-weight: 700;
  }

  .brand-sub {
    color: var(--navy);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav-desktop {
    display: none;
    gap: 0.25rem;
  }

  .nav-desktop a {
    padding: 0.55rem 0.85rem;
    border-radius: 999px;
    font-weight: 500;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .nav-desktop a:hover,
  .nav-desktop a:focus-visible {
    color: var(--pink-hot);
    background: var(--pink-soft);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .phone-btn,
  .quote-btn {
    display: none;
    padding: 0.65rem 1.1rem;
    font-size: 0.9rem;
  }

  .menu-toggle {
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: white;
    display: grid;
    place-content: center;
    gap: 5px;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }

  .nav-mobile {
    display: grid;
    gap: 0.35rem;
    padding: 0.75rem 1rem 1.25rem;
    border-top: 1px solid var(--line);
    background: white;
  }

  .nav-mobile a:not(.btn) {
    padding: 0.85rem 0.5rem;
    font-weight: 550;
    border-bottom: 1px solid var(--line);
  }

  .nav-mobile .btn {
    margin-top: 0.35rem;
  }

  @media (min-width: 980px) {
    .nav-desktop {
      display: flex;
    }
    .phone-btn,
    .quote-btn {
      display: inline-flex;
    }
    .menu-toggle,
    .nav-mobile {
      display: none !important;
    }
  }
</style>
