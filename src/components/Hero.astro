---
import { site } from "../data/site";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-media" aria-hidden="true">
    <img
      src={site.images.hero}
      alt=""
      width="1600"
      height="1067"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
  </div>
  <div class="container hero-content">
    <p class="hero-kicker">{site.name}</p>
    <h1 id="hero-heading">
      Cleaning and Home Watch
      <em>You Can Trust</em>
    </h1>
    <p class="hero-copy">
      Spotless homes and peace of mind across {site.serviceArea}. Deep cleans,
      move-outs, Airbnb turnovers, and home watch—handled with care by a local
      team you can count on.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href={site.phoneHref}>Call {site.phone}</a>
      <a class="btn btn-ghost" href={`${base}#quote`}>Request a Quote</a>
      <a class="btn btn-ghost" href={`${base}#services`}>View Services</a>
    </div>
    <ul class="hero-pills" aria-label="Highlights">
      <li>Local SWFL Team</li>
      <li>Residential and Specialty</li>
      <li>Trusted Since Day One</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 18rem;
    display: grid;
    align-items: end;
    color: white;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg, rgba(18, 10, 22, 0.82) 0%, rgba(18, 10, 22, 0.52) 46%, rgba(194, 24, 91, 0.35) 100%),
      linear-gradient(to top, rgba(18, 10, 22, 0.55), transparent 42%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: 2rem 1.5rem;
    max-width: 46rem;
  }

  .hero-kicker {
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.78rem;
    font-weight: 700;
    opacity: 0.92;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: clamp(2.45rem, 7.2vw, 4.4rem);
    font-weight: 650;
    margin: 0 0 1.1rem;
    line-height: 1.02;
  }

  h1 em {
    font-style: italic;
    color: #ff8fbe;
    font-weight: 600;
  }

  .hero-copy {
    font-size: 1.08rem;
    max-width: 34rem;
    opacity: 0.95;
    margin-bottom: 1.7rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-bottom: 1.75rem;
  }

  .hero-pills {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .hero-pills li {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    backdrop-filter: blur(6px);
  }

  @media (min-width: 768px) {
    .hero-content {
      padding-block: 7.5rem 5.75rem;
    }
  }
</style>
