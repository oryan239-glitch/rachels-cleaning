---
import { site } from "../data/site";
---

<section class="cta" aria-labelledby="cta-heading">
  <div class="container cta-inner">
    <div>
      <h2 id="cta-heading">Let Rachel's Cleaning Take Care of Your Home</h2>
      <p>
        Ready for a fresher space? Request a quote or call us today—we serve
        {site.serviceArea}.
      </p>
    </div>
    <div class="actions">
      <a class="btn btn-white" href="/#contact">{site.cta.primary}</a>
      <a class="btn btn-ghost" href={site.phoneHref}>{site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: linear-gradient(120deg, var(--pink-deep), var(--pink-hot) 55%, #fb7185);
    color: white;
    padding: 3.25rem 0;
  }

  .cta-inner {
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  h2 {
    font-size: clamp(1.5rem, 3.5vw, 2.1rem);
    margin-bottom: 0.5rem;
  }

  p {
    margin: 0;
    opacity: 0.95;
    max-width: 36rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 860px) {
    .cta-inner {
      grid-template-columns: 1.4fr auto;
    }
  }
</style>
