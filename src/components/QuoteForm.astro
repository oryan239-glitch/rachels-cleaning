---
import { site } from "../data/site";

const formSubmitAction = `https://formsubmit.co/${site.email}`;
const subject = "New quote request — Rachel's Cleaning";
---

<form
  class="quote-form"
  id="quote-form"
  action={formSubmitAction}
  method="POST"
>
  <input type="hidden" name="_subject" value={subject} />
  <input type="hidden" name="_captcha" value="false" />
  <input type="hidden" name="_template" value="table" />
  <input type="hidden" name="_next" id="form-next" value={`${site.url}/#quote-sent`} />
  {/* Honeypot — leave empty; bots that fill it are discarded */}
  <input
    type="text"
    name="_honey"
    class="honey"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <p class="success" id="quote-success" hidden role="status">
    Thanks! Your quote request was sent to Rachel. She’ll be in touch soon.
  </p>

  <div class="field field-name">
    <label for="customer-name">Customer name</label>
    <input id="customer-name" type="text" name="Customer name" required autocomplete="name" />
  </div>
  <div class="field field-phone">
    <label for="phone">Phone</label>
    <input id="phone" type="tel" name="Phone" required autocomplete="tel" />
  </div>
  <div class="field field-address">
    <label for="address">Address</label>
    <input id="address" type="text" name="Address" required autocomplete="street-address" />
  </div>
  <div class="field field-email">
    <label for="email">Email</label>
    <input id="email" type="email" name="Email" required autocomplete="email" />
  </div>
  <div class="field field-sqft">
    <label for="sqft">Approx. sq ft</label>
    <input id="sqft" type="number" name="Approximate square footage" min="1" step="1" required inputmode="numeric" />
  </div>
  <div class="field field-bedrooms">
    <label for="bedrooms">Bedrooms</label>
    <input id="bedrooms" type="number" name="Bedrooms" min="0" step="1" required inputmode="numeric" />
  </div>
  <div class="field field-bathrooms">
    <label for="bathrooms">Bathrooms</label>
    <input id="bathrooms" type="number" name="Bathrooms" min="0" step="0.5" required inputmode="decimal" />
  </div>
  <div class="footer-row">
    <fieldset class="pets">
      <legend>Pets</legend>
      <div class="pets-options" role="radiogroup" aria-label="Pets">
        <label class="radio">
          <input type="radio" name="Pets" value="Yes" required />
          <span>Yes</span>
        </label>
        <label class="radio">
          <input type="radio" name="Pets" value="No" />
          <span>No</span>
        </label>
      </div>
    </fieldset>
    <div class="actions">
      <button class="btn btn-primary" type="submit">{site.cta.primary}</button>
      <p class="hint">
        Sends straight to Rachel—no email app needed. First-time submissions may ask her to confirm once via FormSubmit.
      </p>
    </div>
  </div>
</form>

<script>
  const next = document.getElementById("form-next");
  if (next instanceof HTMLInputElement) {
    const path = `${window.location.origin}${window.location.pathname}`;
    next.value = `${path}#quote-sent`;
  }

  const success = document.getElementById("quote-success");
  if (success && location.hash === "#quote-sent") {
    success.hidden = false;
    document.getElementById("quote")?.scrollIntoView({ behavior: "smooth", block: "start" });
  }
</script>

<style>
  .honey {
    display: none !important;
  }

  .success {
    grid-column: 1 / -1;
    margin: 0 0 0.35rem;
    padding: 0.45rem 0.6rem;
    border-radius: 6px;
    background: color-mix(in srgb, var(--pink) 14%, white);
    border: 1px solid color-mix(in srgb, var(--pink-hot) 35%, white);
    color: var(--ink-soft);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .quote-form {
    display: grid;
    gap: 0.4rem 0.6rem;
    grid-template-columns: 1fr;
    position: relative;
  }

  .field {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }

  .field label,
  .pets legend {
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
    line-height: 1.2;
  }

  .pets {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.55rem;
    min-width: 0;
  }

  .pets legend {
    padding: 0;
    float: left;
    width: auto;
    margin: 0;
  }

  .quote-form input[type="text"],
  .quote-form input[type="tel"],
  .quote-form input[type="email"],
  .quote-form input[type="number"] {
    width: 100%;
    border: 1px solid #d8d2d6;
    border-radius: 6px;
    padding: 0.3rem 0.5rem;
    background: #fafafa;
    font: inherit;
    font-size: 0.86rem;
    line-height: 1.25;
    min-height: 1.85rem;
  }

  .quote-form input:focus {
    outline: 2px solid color-mix(in srgb, var(--pink) 35%, white);
    border-color: var(--pink-hot);
    background: #fff;
  }

  .pets-options {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .radio {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    min-width: 0;
  }

  .radio input {
    accent-color: var(--pink-deep);
    margin: 0;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem 0.85rem;
    margin-top: 0.1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.65rem;
  }

  .actions .btn {
    width: auto;
    padding: 0.4rem 0.85rem;
    font-size: 0.84rem;
    min-height: 2rem;
  }

  .hint {
    margin: 0;
    font-size: 0.7rem;
    color: var(--muted);
    line-height: 1.25;
    max-width: 18rem;
  }

  /* Dense 2-col: name|phone, address|email; then sqft|beds|baths; pets+submit row */
  @media (min-width: 640px) {
    .quote-form {
      grid-template-columns: repeat(6, 1fr);
    }

    .field-name,
    .field-phone,
    .field-address,
    .field-email {
      grid-column: span 3;
    }

    .field-sqft,
    .field-bedrooms,
    .field-bathrooms {
      grid-column: span 2;
    }

    .footer-row {
      grid-column: 1 / -1;
    }
  }
</style>
