---
import { site } from "../data/site";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={base} aria-label={`${site.name} home`}>
      <img class="brand-logo" src={`${base}images/wordmark.svg`} alt="" width="180" height="40" />
      <span class="sr-only">{site.name}</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a class="phone-link" href={site.phoneHref}>{site.phone}</a>
      <a class="btn btn-primary quote-btn" href={`${base}#contact`}>{site.cta.primary}</a>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        id="menu-toggle"
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="nav-mobile" id="mobile-nav" aria-label="Mobile" hidden>
    {site.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a class="btn btn-outline" href={site.phoneHref}>{site.phone}</a>
    <a class="btn btn-primary" href={`${base}#contact`}>{site.cta.primary}</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const panel = document.getElementById("mobile-nav");
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    toggle.setAttribute("aria-label", open ? "Open menu" : "Close menu");
    if (panel) panel.hidden = open;
  });
  panel?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      if (toggle && panel) {
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Open menu");
        panel.hidden = true;
      }
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 78px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-width: 0;
  }

  .brand-logo {
    width: min(168px, 46vw);
    height: auto;
  }

  .nav-desktop {
    display: none;
    gap: 0.15rem;
  }

  .nav-desktop a {
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    font-weight: 600;
    color: var(--ink-soft);
    font-size: 0.92rem;
  }

  .nav-desktop a:hover,
  .nav-desktop a:focus-visible {
    color: var(--pink-deep);
    background: var(--pink-soft);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .phone-link {
    display: none;
    font-weight: 700;
    color: var(--pink-deep);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .phone-link:hover {
    color: var(--pink-hot);
  }

  .quote-btn {
    display: none;
    padding: 0.7rem 1.2rem;
    font-size: 0.88rem;
  }

  .menu-toggle {
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: white;
    display: grid;
    place-content: center;
    gap: 5px;
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 18px;
    height: 2px;
    background: var(--ink);
    border-radius: 2px;
  }

  .nav-mobile {
    display: grid;
    gap: 0.35rem;
    padding: 0.75rem 1rem 1.25rem;
    border-top: 1px solid var(--line);
    background: white;
  }

  .nav-mobile a:not(.btn) {
    padding: 0.9rem 0.5rem;
    font-weight: 600;
    border-bottom: 1px solid var(--line);
  }

  .nav-mobile .btn {
    margin-top: 0.35rem;
  }

  @media (min-width: 980px) {
    .nav-desktop {
      display: flex;
    }
    .phone-link,
    .quote-btn {
      display: inline-flex;
    }
    .menu-toggle,
    .nav-mobile {
      display: none !important;
    }
  }
</style>
