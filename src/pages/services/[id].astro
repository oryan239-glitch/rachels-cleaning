---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, services } from "../../data/site";

export function getStaticPaths() {
  return services.map((service) => ({
    params: { id: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const servicesAnchor = `${base}#services`;
const quoteHref = `${base}#quote`;
---

<BaseLayout
  title={`${service.title} | ${site.name}`}
  description={service.description}
  path={`/services/${service.id}`}
>
  <article class="service-page">
    <div class="container">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href={base}>Home</a>
        <span aria-hidden="true">/</span>
        <a href={servicesAnchor}>Services</a>
        <span aria-hidden="true">/</span>
        <span>{service.title}</span>
      </nav>

      <div class="layout">
        <div class="copy">
          <p class="eyebrow">Cleaning Service</p>
          <h1>{service.title}</h1>
          <p class="lead">{service.details}</p>

          <h2>What’s Included</h2>
          <ul class="includes">
            {service.includes.map((item) => (
              <li>
                <span class="check" aria-hidden="true">✓</span>
                {item}
              </li>
            ))}
          </ul>

          <div class="actions">
            <a class="btn btn-primary" href={quoteHref}>Get a Quote</a>
            <a class="btn btn-outline" href={servicesAnchor}>Back to Services</a>
          </div>
        </div>

        <figure class="photo">
          <img
            src={service.image}
            alt={`${service.title} — ${site.name}`}
            width="900"
            height="700"
            loading="eager"
          />
        </figure>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .service-page {
    padding: 1.75rem 0 3.5rem;
    background: var(--bg);
  }

  .crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
    font-size: 0.86rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .crumb a {
    color: var(--pink-deep);
    font-weight: 600;
  }

  .crumb a:hover {
    color: var(--pink-hot);
  }

  .layout {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  h1 {
    font-size: clamp(2rem, 4.5vw, 2.85rem);
    margin-bottom: 0.75rem;
  }

  .lead {
    margin-bottom: 1.5rem;
  }

  h2 {
    font-family: var(--font);
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--pink-deep);
    margin-bottom: 0.85rem;
  }

  .includes {
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    display: grid;
    gap: 0.65rem;
  }

  .includes li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .check {
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
    display: grid;
    place-items: center;
    font-size: 0.72rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 0.1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .photo {
    margin: 0;
    border-radius: 22px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 5 / 4;
    background: var(--bg-soft);
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 2.75rem;
    }
  }
</style>
