---
import { site } from "../data/site";
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="panel">
      <div class="copy">
        <p class="eyebrow">Contact</p>
        <h2 id="contact-heading">Request a quote</h2>
        <p class="lead">
          Tell us about the property and we’ll follow up with pricing and
          availability.
        </p>
        <p class="meta">
          <a href={site.phoneHref}>{site.phone}</a>
          <span aria-hidden="true">·</span>
          <a href={site.emailHref}>{site.email}</a>
          <span aria-hidden="true">·</span>
          <span>{site.address.city}, {site.address.region}</span>
        </p>
      </div>

      <form
        class="quote-form"
        id="quote-form"
        action={`mailto:${site.email}`}
        method="post"
        enctype="text/plain"
      >
        <div class="field">
          <label for="customer-name">Customer name</label>
          <input id="customer-name" type="text" name="Customer name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="phone">Phone number</label>
          <input id="phone" type="tel" name="Phone" required autocomplete="tel" />
        </div>
        <div class="field field-span">
          <label for="address">Address</label>
          <input id="address" type="text" name="Address" required autocomplete="street-address" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" type="email" name="Email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="sqft">Approx. square footage</label>
          <input id="sqft" type="number" name="Approximate square footage" min="1" step="1" required inputmode="numeric" />
        </div>
        <div class="field">
          <label for="bedrooms">Bedrooms</label>
          <input id="bedrooms" type="number" name="Bedrooms" min="0" step="1" required inputmode="numeric" />
        </div>
        <div class="field">
          <label for="bathrooms">Bathrooms</label>
          <input id="bathrooms" type="number" name="Bathrooms" min="0" step="0.5" required inputmode="decimal" />
        </div>
        <fieldset class="field field-span pets">
          <legend>Pets</legend>
          <div class="pets-options" role="radiogroup" aria-label="Pets">
            <label class="radio">
              <input type="radio" name="Pets" value="Yes" required />
              <span>Yes</span>
            </label>
            <label class="radio">
              <input type="radio" name="Pets" value="No" />
              <span>No</span>
            </label>
          </div>
        </fieldset>
        <div class="actions field-span">
          <button class="btn btn-primary" type="submit">{site.cta.primary}</button>
          <p class="hint">Opens your email app with the details ready to send.</p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 2.75rem 0 3.25rem;
    background: var(--pink-blush, #fdf2f7);
    border-top: 1px solid var(--line, #ebe6ea);
  }

  .panel {
    display: grid;
    gap: 1.5rem;
    background: #fff;
    border: 1px solid var(--line, #ebe6ea);
    border-radius: 20px;
    padding: 1.35rem 1.25rem 1.45rem;
    box-shadow: var(--shadow);
  }

  .eyebrow {
    margin: 0 0 0.3rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--pink-deep);
  }

  h2 {
    margin: 0;
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.5rem, 3vw, 1.95rem);
    line-height: 1.15;
  }

  .lead {
    margin: 0.55rem 0 0;
    color: var(--muted);
    font-size: 0.98rem;
    max-width: 34rem;
  }

  .meta {
    margin: 0.75rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.55rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .meta a {
    color: var(--pink-deep);
    font-weight: 700;
  }

  .quote-form {
    display: grid;
    gap: 0.75rem 0.85rem;
    grid-template-columns: 1fr;
  }

  .field {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
  }

  .field label,
  .pets legend {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
  }

  .pets {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .pets legend {
    padding: 0;
    margin-bottom: 0.3rem;
  }

  .quote-form input[type="text"],
  .quote-form input[type="tel"],
  .quote-form input[type="email"],
  .quote-form input[type="number"] {
    width: 100%;
    border: 1px solid #d8d2d6;
    border-radius: 10px;
    padding: 0.58rem 0.75rem;
    background: #fafafa;
    font: inherit;
  }

  .quote-form input:focus {
    outline: 3px solid color-mix(in srgb, var(--pink) 35%, white);
    border-color: var(--pink-hot);
    background: #fff;
  }

  .pets-options {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .radio {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid #d8d2d6;
    border-radius: 999px;
    background: #fafafa;
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 600;
    min-width: 5.5rem;
    justify-content: center;
  }

  .radio:has(input:checked) {
    border-color: var(--pink-hot);
    background: var(--pink-soft);
    color: var(--pink-deep);
  }

  .radio input {
    accent-color: var(--pink-deep);
  }

  .actions {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.15rem;
  }

  .actions .btn {
    width: 100%;
    padding: 0.72rem 1.1rem;
  }

  .hint {
    margin: 0;
    font-size: 0.8rem;
    color: var(--muted);
  }

  @media (min-width: 720px) {
    .quote-form {
      grid-template-columns: 1fr 1fr;
    }

    .field-span {
      grid-column: 1 / -1;
    }

    .actions {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 0.85rem;
    }

    .actions .btn {
      width: auto;
      min-width: 11rem;
    }
  }

  @media (min-width: 960px) {
    .panel {
      grid-template-columns: minmax(14rem, 0.85fr) minmax(0, 1.35fr);
      gap: 2rem;
      align-items: start;
      padding: 1.75rem 1.75rem 1.85rem;
    }

    .copy {
      padding-top: 0.25rem;
    }
  }
</style>
