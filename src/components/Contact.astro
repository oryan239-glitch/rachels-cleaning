---
import { site } from "../data/site";
---

<section class="section contact" id="contact" aria-labelledby="contact-heading">
  <div class="container contact-grid">
    <div class="contact-main">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-heading" class="section-title">
        Get in <span class="accent">touch</span>
      </h2>
      <p class="lead compact">
        Questions or ready to book? Call, email, or send a short quote request.
      </p>

      <ul class="contact-list">
        <li>
          <span class="label">Phone</span>
          <a href={site.phoneHref}>{site.phone}</a>
        </li>
        <li>
          <span class="label">Email</span>
          <a href={site.emailHref}>{site.email}</a>
        </li>
        <li>
          <span class="label">Area</span>
          <span>{site.address.full}</span>
        </li>
      </ul>

      <form
        class="quote-form"
        id="quote-form"
        action={`mailto:${site.email}`}
        method="get"
        enctype="text/plain"
      >
        <div class="form-head">
          <h3>Quick quote</h3>
          <a class="phone-link" href={site.phoneHref}>or call {site.phone}</a>
        </div>
        <div class="fields">
          <label>
            <span class="sr-only">Name</span>
            <input type="text" name="name" placeholder="Name" required />
          </label>
          <label>
            <span class="sr-only">Phone</span>
            <input type="tel" name="phone" placeholder="Phone" required />
          </label>
          <label class="span-2">
            <span class="sr-only">Email</span>
            <input type="email" name="email" placeholder="Email" required />
          </label>
          <label class="span-2">
            <span class="sr-only">Message</span>
            <textarea name="body" rows="2" placeholder="What do you need cleaned?" required></textarea>
          </label>
        </div>
        <button class="btn btn-primary" type="submit">{site.cta.primary}</button>
      </form>
    </div>

    <div class="map-col">
      <div class="map-wrap">
        <iframe
          title="Map of San Carlos Park / Fort Myers service area"
          src={site.mapEmbedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
      <a class="map-link" href={site.mapLink} target="_blank" rel="noopener noreferrer">
        Open map
      </a>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    gap: 1.75rem;
  }

  .lead.compact {
    margin: 0.35rem 0 1rem;
    max-width: 36rem;
    font-size: 1rem;
  }

  .contact-list {
    list-style: none;
    padding: 0;
    margin: 0 0 1.1rem;
    display: grid;
    gap: 0.45rem;
  }

  .contact-list li {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.5rem;
    align-items: baseline;
    font-size: 0.95rem;
  }

  .label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    font-weight: 700;
  }

  .contact-list a,
  .contact-list span:last-child {
    color: var(--pink-deep);
    font-weight: 700;
    word-break: break-word;
  }

  .quote-form {
    background: white;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 0.9rem 1rem 1rem;
    box-shadow: var(--shadow);
    display: grid;
    gap: 0.65rem;
    scroll-margin-top: 5.5rem;
  }

  .form-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
  }

  .quote-form h3 {
    margin: 0;
    font-size: 1.05rem;
  }

  .phone-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--pink-deep);
  }

  .fields {
    display: grid;
    gap: 0.5rem;
  }

  @media (min-width: 520px) {
    .fields {
      grid-template-columns: 1fr 1fr;
    }
    .span-2 {
      grid-column: 1 / -1;
    }
  }

  input,
  textarea {
    width: 100%;
    border: 1px solid #d8d2d6;
    border-radius: 10px;
    padding: 0.65rem 0.8rem;
    background: #fafafa;
    font: inherit;
  }

  textarea {
    resize: vertical;
    min-height: 2.75rem;
  }

  input:focus,
  textarea:focus {
    outline: 3px solid color-mix(in srgb, var(--pink) 35%, white);
    border-color: var(--pink-hot);
    background: white;
  }

  .quote-form .btn {
    justify-self: start;
    padding: 0.65rem 1.15rem;
  }

  .map-col {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .map-wrap {
    border-radius: 14px;
    overflow: hidden;
    box-shadow: var(--shadow);
    background: white;
    min-height: 220px;
  }

  iframe {
    border: 0;
    width: 100%;
    height: 220px;
    display: block;
  }

  .map-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--pink-deep);
  }

  @media (min-width: 960px) {
    .contact-grid {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 2rem;
      align-items: start;
    }

    .map-wrap,
    iframe {
      min-height: 280px;
      height: 280px;
    }
  }
</style>
