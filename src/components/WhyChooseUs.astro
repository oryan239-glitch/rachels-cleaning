---
import { site, aboutHighlights } from "../data/site";
---

<section class="section why" id="about" aria-labelledby="why-heading">
  <div class="container why-grid">
    <div class="why-visual">
      <img
        src={site.images.about}
        alt="Bright white kitchen after a professional clean"
        width="900"
        height="720"
        loading="lazy"
      />
      <div class="float-card">
        <img
          src={site.images.portrait}
          alt={site.owner}
          width="72"
          height="72"
          loading="lazy"
        />
        <div>
          <strong>{site.owner}</strong>
          <span>Owner and Lead Cleaner</span>
        </div>
      </div>
    </div>
    <div class="why-copy">
      <p class="eyebrow">About Us</p>
      <h2 id="why-heading" class="section-title">
        Why Homeowners <span class="accent">Choose Us</span>
      </h2>
      <p class="lead">
        Enjoy more time, less worry, and a beautifully maintained home with
        {site.name}. We bring care, consistency, and a polished finish to every visit.
      </p>
      <ul class="highlights">
        {
          aboutHighlights.map((item) => (
            <li>
              <span class="check" aria-hidden="true">✓</span>
              {item}
            </li>
          ))
        }
      </ul>
      <div class="actions">
        <a class="btn btn-outline" href={site.phoneHref}>Call {site.phone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .why-grid {
    display: grid;
    gap: 2.25rem;
  }

  .why-visual {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    aspect-ratio: 5 / 4;
  }

  .why-visual > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .float-card {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    right: 1rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow);
  }

  .float-card img {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--pink-soft);
  }

  .float-card strong {
    display: block;
    font-size: 0.98rem;
  }

  .float-card span {
    color: var(--muted);
    font-size: 0.86rem;
  }

  .highlights {
    list-style: none;
    padding: 0;
    margin: 1.6rem 0 2rem;
    display: grid;
    gap: 0.8rem;
  }

  .highlights li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    font-weight: 650;
    font-size: 1.02rem;
  }

  .check {
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 50%;
    background: var(--pink-soft);
    color: var(--pink-deep);
    display: grid;
    place-items: center;
    font-size: 0.78rem;
    font-weight: 800;
    flex-shrink: 0;
    margin-top: 0.05rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 900px) {
    .why-grid {
      grid-template-columns: 0.95fr 1.05fr;
      gap: 3.75rem;
      align-items: center;
    }

    .float-card {
      right: auto;
      min-width: 240px;
    }
  }
</style>
