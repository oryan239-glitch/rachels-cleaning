---
import { site, services } from "../data/site";
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="brand-col">
      <a class="brand" href={base} aria-label={`${site.name} home`}>
        <img src={`${base}images/wordmark.svg`} alt="" width="180" height="40" />
      </a>
      <p>
        Professional residential and specialty cleaning for Fort Myers, San
        Carlos Park, and nearby Southwest Florida communities.
      </p>
      <a class="phone" href={site.phoneHref}>{site.phone}</a>
    </div>

    <div>
      <h3>Services</h3>
      <ul>
        {
          services.slice(0, 5).map((s) => (
            <li>
              <a href={`${base}services/${s.id}`}>{s.title}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3>Explore</h3>
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        <li><a href={`${base}#faq`}>FAQ</a></li>
        <li><a href={`${base}#testimonials`}>Testimonials</a></li>
        <li><a href={`${base}#contact`}>{site.cta.primary}</a></li>
      </ul>
    </div>

    <div>
      <h3>Contact</h3>
      <ul class="contact">
        <li><a href={site.emailHref}>{site.email}</a></li>
        <li><a href={site.phoneHref}>{site.phone}</a></li>
        <li>{site.address.full}</li>
      </ul>
    </div>
  </div>
  <div class="container legal">
    <p>© {year} {site.legalName}. All rights reserved. Cleaning services only.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: rgba(255, 255, 255, 0.88);
    padding: 3.75rem 0 1.5rem;
  }

  .footer-grid {
    display: grid;
    gap: 2rem;
  }

  .brand {
    display: inline-block;
    margin-bottom: 1rem;
    filter: brightness(0) invert(1);
    opacity: 0.95;
  }

  .brand img {
    width: 170px;
    height: auto;
  }

  .brand-col p {
    color: rgba(255, 255, 255, 0.7);
    max-width: 22rem;
  }

  .phone {
    color: #ff8fbe;
    font-weight: 700;
  }

  h3 {
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 0.9rem;
    color: white;
    font-family: var(--font);
    font-weight: 700;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  a:hover {
    color: #ff8fbe;
  }

  .contact li,
  .contact a {
    color: rgba(255, 255, 255, 0.72);
    word-break: break-word;
  }

  .legal {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.55);
    font-size: 0.9rem;
  }

  .legal p {
    margin: 0;
  }

  @media (min-width: 760px) {
    .footer-grid {
      grid-template-columns: 1.45fr 1fr 1fr 1.1fr;
    }
  }
</style>
