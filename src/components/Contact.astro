---
import { site } from "../data/site";
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const quoteHref = `${base}quote`;
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="panel">
      <div class="copy">
        <p class="eyebrow">Get Started</p>
        <h2 id="contact-heading">Ready for a spotless home?</h2>
        <p class="lead">
          Tell us about your property and we’ll send a clear cleaning quote.
          No obligation—just a straightforward estimate from a local team.
        </p>
        <p class="meta">
          <a href={site.phoneHref}>{site.phone}</a>
          <span aria-hidden="true">·</span>
          <a href={site.emailHref}>{site.email}</a>
        </p>
      </div>
      <div class="cta">
        <a class="btn btn-primary" href={quoteHref}>{site.cta.primary}</a>
        <a class="btn btn-outline" href={site.phoneHref}>Call {site.phone}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 1.5rem 0 2rem;
    background: var(--pink-blush, #fdf2f7);
    border-top: 1px solid var(--line, #ebe6ea);
  }

  .panel {
    background: #fff;
    border: 1px solid var(--line, #ebe6ea);
    border-radius: 16px;
    padding: 1.25rem 1.35rem;
    box-shadow: var(--shadow);
    display: grid;
    gap: 1.1rem;
    align-items: center;
  }

  .eyebrow {
    margin-bottom: 0.35rem;
  }

  h2 {
    margin: 0 0 0.4rem;
    font-family: var(--font-display, Georgia, serif);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    line-height: 1.2;
  }

  .lead {
    margin: 0 0 0.55rem;
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 36rem;
  }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.4rem;
    color: var(--muted);
    font-size: 0.82rem;
  }

  .meta a {
    color: var(--pink-deep);
    font-weight: 700;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .cta .btn {
    padding: 0.65rem 1.15rem;
    font-size: 0.9rem;
  }

  @media (min-width: 800px) {
    .panel {
      grid-template-columns: 1.4fr auto;
      gap: 1.5rem;
      padding: 1.4rem 1.6rem;
    }
  }
</style>
