---
import { site } from "../data/site";
---

<section class="contact" id="contact" aria-labelledby="contact-heading">
  <div class="container">
    <div class="panel">
      <header class="head">
        <h2 id="contact-heading">Request a quote</h2>
        <p class="meta">
          <a href={site.phoneHref}>{site.phone}</a>
          <span aria-hidden="true">·</span>
          <a href={site.emailHref}>{site.email}</a>
        </p>
      </header>

      <form
        class="quote-form"
        id="quote-form"
        action={`mailto:${site.email}`}
        method="post"
        enctype="text/plain"
      >
        <div class="field">
          <label for="customer-name">Customer name</label>
          <input id="customer-name" type="text" name="Customer name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="phone">Phone</label>
          <input id="phone" type="tel" name="Phone" required autocomplete="tel" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" type="email" name="Email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="address">Address</label>
          <input id="address" type="text" name="Address" required autocomplete="street-address" />
        </div>
        <div class="field">
          <label for="sqft">Approx. sq ft</label>
          <input id="sqft" type="number" name="Approximate square footage" min="1" step="1" required inputmode="numeric" />
        </div>
        <div class="field">
          <label for="bedrooms">Bedrooms</label>
          <input id="bedrooms" type="number" name="Bedrooms" min="0" step="1" required inputmode="numeric" />
        </div>
        <div class="field">
          <label for="bathrooms">Bathrooms</label>
          <input id="bathrooms" type="number" name="Bathrooms" min="0" step="0.5" required inputmode="decimal" />
        </div>
        <fieldset class="field pets">
          <legend>Pets</legend>
          <div class="pets-options" role="radiogroup" aria-label="Pets">
            <label class="radio">
              <input type="radio" name="Pets" value="Yes" required />
              <span>Yes</span>
            </label>
            <label class="radio">
              <input type="radio" name="Pets" value="No" />
              <span>No</span>
            </label>
          </div>
        </fieldset>
        <div class="actions">
          <button class="btn btn-primary" type="submit">{site.cta.primary}</button>
          <p class="hint">Opens your email app with details ready to send.</p>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    padding: 1.25rem 0 1.5rem;
    background: var(--pink-blush, #fdf2f7);
    border-top: 1px solid var(--line, #ebe6ea);
  }

  .panel {
    background: #fff;
    border: 1px solid var(--line, #ebe6ea);
    border-radius: 14px;
    padding: 0.85rem 1rem 1rem;
    box-shadow: var(--shadow);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 0.65rem;
  }

  h2 {
    margin: 0;
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.15rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .meta {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.4rem;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .meta a {
    color: var(--pink-deep);
    font-weight: 700;
  }

  .quote-form {
    display: grid;
    gap: 0.45rem 0.65rem;
    grid-template-columns: 1fr;
  }

  .field {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .field label,
  .pets legend {
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
    line-height: 1.2;
  }

  .pets {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.65rem;
  }

  .pets legend {
    padding: 0;
    float: left;
    width: auto;
    margin: 0;
  }

  .quote-form input[type="text"],
  .quote-form input[type="tel"],
  .quote-form input[type="email"],
  .quote-form input[type="number"] {
    width: 100%;
    border: 1px solid #d8d2d6;
    border-radius: 7px;
    padding: 0.35rem 0.55rem;
    background: #fafafa;
    font: inherit;
    font-size: 0.88rem;
    line-height: 1.3;
    min-height: 2rem;
  }

  .quote-form input:focus {
    outline: 2px solid color-mix(in srgb, var(--pink) 35%, white);
    border-color: var(--pink-hot);
    background: #fff;
  }

  .pets-options {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  .radio {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 600;
    min-width: 0;
  }

  .radio input {
    accent-color: var(--pink-deep);
    margin: 0;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.75rem;
    margin-top: 0.15rem;
  }

  .actions .btn {
    width: auto;
    padding: 0.45rem 0.95rem;
    font-size: 0.88rem;
    min-height: 2.15rem;
  }

  .hint {
    margin: 0;
    font-size: 0.72rem;
    color: var(--muted);
    line-height: 1.3;
  }

  /* Dense 2-col: name|phone, email|address; then sqft|beds|baths */
  @media (min-width: 640px) {
    .quote-form {
      grid-template-columns: repeat(6, 1fr);
    }

    .field:nth-child(1),
    .field:nth-child(2),
    .field:nth-child(3),
    .field:nth-child(4) {
      grid-column: span 3;
    }

    .field:nth-child(5),
    .field:nth-child(6),
    .field:nth-child(7) {
      grid-column: span 2;
    }

    .field.pets,
    .actions {
      grid-column: 1 / -1;
    }
  }
</style>
