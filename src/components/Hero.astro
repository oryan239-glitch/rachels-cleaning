---
import { site } from "../data/site";
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero-media" aria-hidden="true">
    <img
      src="/images/hero-kitchen.jpg"
      alt=""
      width="1600"
      height="1450"
      fetchpriority="high"
    />
    <div class="hero-overlay"></div>
  </div>
  <div class="container hero-content">
    <p class="hero-kicker">{site.name}</p>
    <h1 id="hero-heading">
      Professional Cleaning
      <span class="accent">Services</span>
      You Can Trust
    </h1>
    <p class="hero-copy">
      Spotless homes across {site.serviceArea}. Deep cleans, move-outs, Airbnb
      turnovers, and more—handled with care by a local team you can count on.
    </p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/#contact">{site.cta.primary}</a>
      <a class="btn btn-ghost" href={site.phoneHref}>Call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(28rem, 78vh, 42rem);
    display: grid;
    align-items: end;
    color: white;
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      rgba(10, 12, 24, 0.78) 0%,
      rgba(10, 12, 24, 0.55) 48%,
      rgba(236, 72, 153, 0.28) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 1;
    padding-block: 5rem 4rem;
    max-width: 44rem;
  }

  .hero-kicker {
    text-transform: uppercase;
    letter-spacing: 0.14em;
    font-size: 0.8rem;
    font-weight: 600;
    opacity: 0.92;
    margin-bottom: 0.85rem;
  }

  h1 {
    font-size: clamp(2.2rem, 7vw, 4.25rem);
    font-weight: 700;
    margin: 0 0 1rem;
    line-height: 1.05;
  }

  h1 .accent {
    color: var(--pink-hot);
  }

  .hero-copy {
    font-size: 1.05rem;
    max-width: 34rem;
    opacity: 0.95;
    margin-bottom: 1.6rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .hero-content {
      padding-block: 7rem 5.5rem;
      margin-left: 0;
      width: min(100% - 2rem, var(--container));
    }
  }
</style>
