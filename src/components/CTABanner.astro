---
import { site } from "../data/site";
---

<section class="cta" aria-labelledby="cta-heading">
  <div class="cta-bg" aria-hidden="true">
    <img src={site.images.exterior} alt="" width="1600" height="900" loading="lazy" />
  </div>
  <div class="container cta-inner">
    <div>
      <h2 id="cta-heading">Let Rachel's Cleaning Take Care of Your Home</h2>
      <p>
        Ready for a fresher space? Request a quote or call us today—we serve
        {site.serviceArea}.
      </p>
    </div>
    <div class="actions">
      <a class="btn btn-white" href="/#contact">{site.cta.primary}</a>
      <a class="btn btn-ghost" href={site.phoneHref}>{site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    color: white;
    padding: 4rem 0;
    overflow: hidden;
  }

  .cta-bg {
    position: absolute;
    inset: 0;
  }

  .cta-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta-bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      120deg,
      rgba(194, 24, 91, 0.92),
      rgba(243, 80, 137, 0.88) 55%,
      rgba(26, 21, 35, 0.72)
    );
  }

  .cta-inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }

  h2 {
    font-size: clamp(1.65rem, 3.6vw, 2.35rem);
    margin-bottom: 0.55rem;
  }

  p {
    margin: 0;
    opacity: 0.95;
    max-width: 36rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 860px) {
    .cta-inner {
      grid-template-columns: 1.45fr auto;
    }
  }
</style>
