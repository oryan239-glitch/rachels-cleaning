---
import { site } from "../data/site";
---

<form
  class="quote-form"
  id="quote-form"
  action={`mailto:${site.email}`}
  method="post"
  enctype="text/plain"
>
  <div class="field">
    <label for="customer-name">Customer name</label>
    <input id="customer-name" type="text" name="Customer name" required autocomplete="name" />
  </div>
  <div class="field">
    <label for="phone">Phone</label>
    <input id="phone" type="tel" name="Phone" required autocomplete="tel" />
  </div>
  <div class="field">
    <label for="address">Address</label>
    <input id="address" type="text" name="Address" required autocomplete="street-address" />
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input id="email" type="email" name="Email" required autocomplete="email" />
  </div>
  <div class="field">
    <label for="sqft">Approx. sq ft</label>
    <input id="sqft" type="number" name="Approximate square footage" min="1" step="1" required inputmode="numeric" />
  </div>
  <div class="field">
    <label for="bedrooms">Bedrooms</label>
    <input id="bedrooms" type="number" name="Bedrooms" min="0" step="1" required inputmode="numeric" />
  </div>
  <div class="field">
    <label for="bathrooms">Bathrooms</label>
    <input id="bathrooms" type="number" name="Bathrooms" min="0" step="0.5" required inputmode="decimal" />
  </div>
  <div class="footer-row">
    <fieldset class="pets">
      <legend>Pets</legend>
      <div class="pets-options" role="radiogroup" aria-label="Pets">
        <label class="radio">
          <input type="radio" name="Pets" value="Yes" required />
          <span>Yes</span>
        </label>
        <label class="radio">
          <input type="radio" name="Pets" value="No" />
          <span>No</span>
        </label>
      </div>
    </fieldset>
    <div class="actions">
      <button class="btn btn-primary" type="submit">{site.cta.primary}</button>
      <p class="hint">Opens your email app with details ready to send.</p>
    </div>
  </div>
</form>

<style>
  .quote-form {
    display: grid;
    gap: 0.4rem 0.6rem;
    grid-template-columns: 1fr;
  }

  .field {
    display: grid;
    gap: 0.12rem;
    min-width: 0;
  }

  .field label,
  .pets legend {
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
    line-height: 1.2;
  }

  .pets {
    border: 0;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.55rem;
    min-width: 0;
  }

  .pets legend {
    padding: 0;
    float: left;
    width: auto;
    margin: 0;
  }

  .quote-form input[type="text"],
  .quote-form input[type="tel"],
  .quote-form input[type="email"],
  .quote-form input[type="number"] {
    width: 100%;
    border: 1px solid #d8d2d6;
    border-radius: 6px;
    padding: 0.3rem 0.5rem;
    background: #fafafa;
    font: inherit;
    font-size: 0.86rem;
    line-height: 1.25;
    min-height: 1.85rem;
  }

  .quote-form input:focus {
    outline: 2px solid color-mix(in srgb, var(--pink) 35%, white);
    border-color: var(--pink-hot);
    background: #fff;
  }

  .pets-options {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .radio {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    font-size: 0.8rem;
    font-weight: 600;
    min-width: 0;
  }

  .radio input {
    accent-color: var(--pink-deep);
    margin: 0;
  }

  .footer-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem 0.85rem;
    margin-top: 0.1rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.65rem;
  }

  .actions .btn {
    width: auto;
    padding: 0.4rem 0.85rem;
    font-size: 0.84rem;
    min-height: 2rem;
  }

  .hint {
    margin: 0;
    font-size: 0.7rem;
    color: var(--muted);
    line-height: 1.25;
  }

  /* Dense 2-col: name|phone, address|email; then sqft|beds|baths; pets+submit row */
  @media (min-width: 640px) {
    .quote-form {
      grid-template-columns: repeat(6, 1fr);
    }

    .field:nth-child(1),
    .field:nth-child(2),
    .field:nth-child(3),
    .field:nth-child(4) {
      grid-column: span 3;
    }

    .field:nth-child(5),
    .field:nth-child(6),
    .field:nth-child(7) {
      grid-column: span 2;
    }

    .footer-row {
      grid-column: 1 / -1;
    }
  }
</style>
