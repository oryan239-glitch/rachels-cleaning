---
import { testimonials } from "../data/site";
---

<section class="section" id="testimonials" aria-labelledby="testimonials-heading">
  <div class="container">
    <div class="intro">
      <p class="eyebrow">Happy Homeowners</p>
      <h2 id="testimonials-heading" class="section-title">
        What Clients <span class="accent">Say</span>
      </h2>
    </div>
    <div class="grid">
      {
        testimonials.map((t, i) => (
          <article class:list={["card", i % 2 === 0 ? "card-pink" : "card-white"]}>
            <span class="quote-mark" aria-hidden="true">”</span>
            <div class="stars" aria-label="5 out of 5 stars">★★★★★</div>
            <p>“{t.quote}”</p>
            <div class="person">
              <span class="avatar" aria-hidden="true">{t.name.slice(0, 1)}</span>
              <strong>{t.name}</strong>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .intro {
    margin-bottom: 2rem;
  }

  .grid {
    display: grid;
    gap: 1rem;
  }

  .card {
    position: relative;
    border-radius: 16px;
    padding: 1.5rem 1.35rem 1.35rem;
    box-shadow: var(--shadow);
    min-height: 100%;
  }

  .card-pink {
    background: var(--pink-hot);
    color: white;
  }

  .card-white {
    background: white;
    border: 1px solid var(--line);
  }

  .quote-mark {
    position: absolute;
    top: 0.55rem;
    right: 1rem;
    font-size: 3rem;
    line-height: 1;
    color: var(--navy-deep);
    opacity: 0.85;
    font-family: Georgia, serif;
  }

  .card-pink .quote-mark {
    color: rgba(3, 24, 136, 0.55);
  }

  .stars {
    color: #f5c518;
    letter-spacing: 0.08em;
    margin-bottom: 0.7rem;
    font-size: 0.95rem;
  }

  p {
    margin: 0 0 1.25rem;
    font-size: 0.98rem;
  }

  .person {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .avatar {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.25);
  }

  .card-white .avatar {
    background: var(--pink-soft);
    color: var(--pink-deep);
  }

  @media (min-width: 700px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 980px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
