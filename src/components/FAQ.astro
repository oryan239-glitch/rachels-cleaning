---
import { faqs } from "../data/site";
---

<section class="section" id="faq" aria-labelledby="faq-heading">
  <div class="container faq-grid">
    <div class="faq-intro">
      <p class="eyebrow">Some Questions <span class="amp">&</span> Answers</p>
      <h2 id="faq-heading" class="section-title">
        Frequently Asked <span class="accent">Questions</span>
      </h2>
      <p class="lead">
        Quick answers to the questions we hear most. Need something specific?
        Reach out—we're happy to help.
      </p>
      <div class="faq-ctas">
        <a class="btn btn-primary" href="/#services">View Services</a>
        <a class="btn btn-outline" href="/#contact">Get a Quote!</a>
      </div>
    </div>

    <div class="faq-list">
      {
        faqs.map((item, i) => (
          <details class="faq-item" open={i === 0}>
            <summary>
              <span class="marker" aria-hidden="true"></span>
              <span>{item.question}</span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    gap: 2.5rem;
  }

  .faq-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .faq-list {
    display: grid;
    background: white;
    border: 1px solid var(--line);
    border-radius: 22px;
    padding: 0.35rem 1.25rem;
    box-shadow: var(--shadow);
  }

  .faq-item {
    border-bottom: 1px solid var(--line);
    padding: 0.2rem 0;
  }

  .faq-item:last-child {
    border-bottom: 0;
  }

  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding: 1.15rem 0;
    font-weight: 700;
    font-size: 1.02rem;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .marker {
    width: 1.1rem;
    flex-shrink: 0;
    margin-top: 0.2rem;
    position: relative;
  }

  .marker::before,
  .marker::after {
    content: "";
    position: absolute;
    background: var(--pink-deep);
    border-radius: 2px;
  }

  .marker::before {
    width: 12px;
    height: 2px;
    top: 7px;
    left: 0;
  }

  .marker::after {
    width: 2px;
    height: 12px;
    top: 2px;
    left: 5px;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  details[open] .marker::after {
    opacity: 0;
    transform: scaleY(0);
  }

  .faq-item p {
    margin: 0 0 1.15rem 1.95rem;
    color: var(--muted);
    max-width: 38rem;
  }

  @media (min-width: 900px) {
    .faq-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 3.5rem;
      align-items: start;
    }
  }
</style>
